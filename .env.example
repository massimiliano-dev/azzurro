# Database (PostgreSQL in Docker: npm run db:up). Porta host 5433 per non
# entrare in conflitto con un PostgreSQL locale; cambiala con AZZURRO_DB_PORT.
AZZURRO_DB_PORT=5433
DATABASE_URL=postgres://azzurro:azzurro@localhost:5433/azzurro

# API server
PORT=4000
# URL pubblico con cui client/SDK raggiungono le API (issuer dei token)
PUBLIC_URL=http://localhost:4000
# URL del portale (CORS, link nelle notifiche push)
PORTAL_URL=http://localhost:3000

# Tenant e amministratore creati al primo avvio
AZZURRO_TENANT_NAME=Azzurro
AZZURRO_DOMAIN=azzurro.local
AZZURRO_ADMIN_PASSWORD=Azzurro123!

# strict (default) = token obbligatorio; lax = richieste anonime trattate come admin
AZZURRO_AUTH=strict
# on (default) = RBAC applicato sulle API ARM; off = qualsiasi utente autenticato può tutto
AZZURRO_RBAC=on

# Contatto VAPID per web push
AZZURRO_VAPID_SUBJECT=mailto:admin@azzurro.local

# Portale Next.js: dove inoltrare le chiamate API (rewrites)
AZZURRO_API_URL=http://localhost:4000

# --- Accesso al portale con Microsoft Entra ID (tenant aziendale) ---
# App registration a tenant singolo con redirect web {PORTAL_URL}/api/portal/auth/callback
# e ruoli dell'app Azzurro.Owner / Azzurro.Contributor / Azzurro.Reader assegnati a utenti o gruppi.
AZZURRO_MS_TENANT_ID=
AZZURRO_MS_CLIENT_ID=
AZZURRO_MS_CLIENT_SECRET=
# Login con utente e password della directory emulata: di default attivo solo se Microsoft non è configurato
# AZZURRO_LOCAL_LOGIN=off

# --- Assistente (almeno una chiave) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AZZURRO_CLAUDE_MODEL=claude-opus-5-5
# AZZURRO_OPENAI_MODEL=gpt-5
# AZZURRO_ASSISTANT_PROVIDER=claude
# AZZURRO_LOCAL_MODEL=qwen3.8:27b
# AZZURRO_LOCAL_AI_URL=http://localhost:11434/v1
